spring.datasource.username=${DB_USERNAME:root}
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/Grocify}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.password=${DB_PASSWORD:}

spring.jpa.hibernate.ddl-auto=${JPA_HIBERNATE_DDL:update}
server.port=${SERVER_PORT:8080}
spring.output.ansi.enabled=ALWAYS

razorpay.key=${RAZORPAY_KEY:}
razorpay.secret=${RAZORPAY_SECRET:}

spring.ai.ollama.base-url=${OLLAMA_BASE_URL:http://localhost:11434}
spring.ai.ollama.chat.options.model=${OLLAMA_MODEL:phi3}

jwt.secret=${JWT_SECRET:}
jwt.expiration=${JWT_EXPIRATION:86400000}

